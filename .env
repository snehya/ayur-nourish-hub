# Database Configuration for Supabase PostgreSQL
# Replace the placeholder values below with your actual Supabase credentials

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_HOST=YOUR_SUPABASE_HOST
DB_PORT=5432

# To get your Supabase credentials:
# 1. Go to your Supabase project dashboard
# 2. Navigate to Settings > Database
# 3. Copy the Host, Password from the connection info
# 4. The database name is usually 'postgres'
# 5. The user is usually 'postgres'

# Optional: You can also set a complete DATABASE_URL instead
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

